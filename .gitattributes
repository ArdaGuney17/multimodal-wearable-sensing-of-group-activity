# Git LFS tracking — raw sensor data and any large external assets only.
# Everything under data/processed/ and results/ is REGENERATED by the pipeline
# and is intentionally NOT tracked here (see .gitignore) — it should never need LFS.

data/raw/** filter=lfs diff=lfs merge=lfs -text
data/external/** filter=lfs diff=lfs merge=lfs -text

# results/tables/*.csv are small, human-diffable reproduction outputs —
# deliberately plain git, NOT LFS, so they render/diff normally on GitHub.
