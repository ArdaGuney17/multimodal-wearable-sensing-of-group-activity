# Raw data is archived on Zenodo, pulled locally by src/data/download.py — never committed.
data/raw/
data/external/

# Prepared Zenodo upload archives (built by scripts/build_zenodo_archive.py) — uploaded
# directly to Zenodo by hand, never committed to git.
data/zenodo_upload/

# Regenerated by the pipeline — never committed. Re-run scripts to recreate.
data/processed/
results/tables/*.csv.tmp
results/figures/*.png
!results/figures/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Notebook / Colab clutter
.ipynb_checkpoints/
*-checkpoint.ipynb

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local env / secrets
.env
*.local

# Large model checkpoints (regenerated by training scripts, not committed)
**/checkpoints/
**/*.ckpt
**/*.pt
